rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access unless explicitly allowed below
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connectivity test / seed marker collection
    match /test/{docId} {
      allow read, write: if isValidId(docId);
    }

    // ---------------------------------------------------------------
    // Core application state (one document per entity)
    // ---------------------------------------------------------------
    match /users/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /courses/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /classes/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /students/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0;
      allow delete: if isValidId(docId);
    }

    match /enrollments/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /charges/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /receipts/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /cash_registers/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /cash_movements/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /assessments/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /grades/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /lessons/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /assignments/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /submissions/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /attendance/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /accounting_transactions/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /audit_logs/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /notifications/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /pending_registrations/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /pending_payments/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    // ---------------------------------------------------------------
    // System settings (single document: settings/main)
    // ---------------------------------------------------------------
    match /settings/{docId} {
      allow read: if true;
      allow write: if docId == 'main';
    }

    // ---------------------------------------------------------------
    // Accounting module collections
    // ---------------------------------------------------------------
    match /accounting_revenues/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /accounting_expenses/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /expense_reports/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    // ---------------------------------------------------------------
    // Teacher / LMS module collections
    // ---------------------------------------------------------------
    match /class_topics/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /class_announcements/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /didactic_materials/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /quizzes/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /quiz_submissions/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /general_announcements/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /lesson_plans/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }
  }
}
